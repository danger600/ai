# Local development configuration only. Never commit real secrets.

# --- Application Settings ---
APP_ENV=development
APP_PORT=8000
APP_DEBUG=true
APP_SECRET_KEY=change_this_to_a_random_local_secret

# --- UI & Localization ---
APP_THEME=obsidian_dark
APP_LANGUAGE=en

# --- Cloud AI Provider (OpenAI) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_CLOUD_MODEL=gpt-4o-mini

# --- Local AI Provider (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_LOCAL_MODEL=llama3

# --- AI Generation Parameters ---
AI_PROVIDER=local # Options: local, cloud
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_REQUEST_TIMEOUT=60

# --- Storage & Database ---
DATABASE_URL=sqlite:///./local_dev.db
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=INFO
